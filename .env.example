# PHANTA production environment template. Never commit real secrets.
# Copy to .env locally and replace every REQUIRED value with a real secret/config value.
# Railway: add these as Railway Variables; do not upload a real .env file to Git.

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/phanta
# REQUIRED IN PRODUCTION. database/migrations.py refuses to run Alembic without
# it whenever FLASK_ENV/APP_ENV/RAILWAY_ENVIRONMENT indicates production, so
# preDeployCommand exits 1 and the deploy fails before the app starts.
# It exists so migrations can use a more privileged role than the app; if you
# do not need that, set it to exactly the same value as DATABASE_URL.
ADMIN_DATABASE_URL=postgresql://user:password@localhost:5432/phanta
# Railway PostgreSQL may also expose these values; PHANTA can construct DATABASE_URL from them:
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGCONNECT_TIMEOUT=5
PGPOOL_MINCONN=1
PGPOOL_MAXCONN=5
REQUIRE_DATABASE_URL=true
PHANTA_SQLITE_PATH=phanta.db
PHANTA_TEST_POSTGRES_URL=

# ============================================================
# APPLICATION / FLASK
# ============================================================
FLASK_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DEV_FLASK_SECRET_KEY=
FLASK_ENV=production
APP_ENV=production
ENVIRONMENT=production
PORT=8080
# Rate limiting uses in-process memory, which is only accurate with ONE web
# worker. Raise this only after setting RATELIMIT_STORAGE_URI to a shared store.
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
DEFAULT_RATE_LIMIT=300 per hour
RATELIMIT_STORAGE_URI=memory://
RAILWAY_ENVIRONMENT=
RAILWAY_SERVICE_ID=

# ============================================================
# SUPER ADMIN BOOTSTRAP
# ============================================================
SUPERADMIN_USERNAME=admin@phanta.local
SUPERADMIN_PASSWORD=REPLACE_BEFORE_PRODUCTION_USE
SUPERADMIN_NAME=PHANTA Platform Super Admin
ALLOW_DEV_DEFAULT_CREDENTIALS=false
DEV_SUPERADMIN_PASSWORD=

# ============================================================
# META APP — SHARED
# ============================================================
# One VANTA Meta App shared by WhatsApp, Embedded Signup and Flyer Lady.
# These are application-level credentials, not client/workshop credentials.
META_APP_ID=
META_APP_SECRET=
# Optional override. The application defaults to v26.0 when this is unset.
META_GRAPH_API_VERSION=v26.0

# ============================================================
# META TOKEN ENCRYPTION / SECURITY
# ============================================================
# Required when encrypted provider tokens are stored/read. Keep this stable:
# changing it can make existing encrypted database values unreadable.
META_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY

# ============================================================
# META WEBHOOK SECURITY
# ============================================================
# Required only when Meta webhooks are configured/enabled on this deployment.
META_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_A_RANDOM_WEBHOOK_VERIFY_TOKEN
# META_APP_SECRET above is also used for X-Hub-Signature-256 verification.

# ============================================================
# WHATSAPP — SYSTEM USER OPERATIONS
# ============================================================
# Conditional. Required only for operations that explicitly use the Meta
# System User token; do not treat this as a Flyer Lady or Embedded Signup
# requirement.
META_SYSTEM_USER_TOKEN=

# ============================================================
# WHATSAPP TECH PROVIDER ONBOARDING (VANTA as billing aggregator)
# ============================================================
# Required to complete Meta onboarding for a new client. Without these, a
# client's Embedded Signup will stop at "onboarding" rather than being
# reported (falsely) as connected.
#
# VANTA's Meta business portfolio ID. Meta Business Suite > Business settings
# > Business info. Owns the System User and the extended credit line.
META_BUSINESS_ID=

# Optional but recommended. The numeric System User ID that
# META_SYSTEM_USER_TOKEN represents. It is verified against Meta at onboarding
# time; a value that disagrees with Meta is a hard error, never silently
# ignored. Leave blank to have it discovered from the token.
META_SYSTEM_USER_ID=

# Optional. VANTA's Meta extended credit line ID. Leave blank to discover it
# from GET /<META_BUSINESS_ID>/extendedcredits. A configured value must belong
# to META_BUSINESS_ID or onboarding fails rather than sharing the wrong line.
META_CREDIT_LINE_ID=

# Billing model switch. Default true: VANTA's credit line is attached to each
# client WABA, so clients pay VANTA and VANTA receives the aggregated Meta
# invoice. Set to false ONLY as a deliberate decision to have clients pay Meta
# directly -- it changes who is billed.
# Note: Meta accepts only AUD, EUR, GBP, IDR, INR and USD as the WABA billing
# currency for credit sharing. ZAR is NOT supported.
META_CREDIT_SHARING_ENABLED=true

# Optional. Tasks granted to VANTA's System User on each client WABA.
# MANAGE is admin access. If VANTA is added via a Multi-Partner Solution
# without MESSAGING, use granular tasks instead and include MANAGE_BILLING,
# which Meta requires for credit-line sharing.
# META_WABA_ASSIGNED_TASKS=MANAGE

# ============================================================
# WHATSAPP EMBEDDED SIGNUP
# ============================================================
# Conditional. Required only when WhatsApp Embedded Signup is enabled/used.
# Use META_WHATSAPP_CONFIG_ID as the canonical deployment variable.
META_WHATSAPP_CONFIG_ID=

# Conditional. HTTPS application domain(s) used by the current Embedded Signup
# configuration validation. Multiple values may be comma-separated.
META_APP_DOMAINS=

# Backward-compatible alias supported by the current code. Do not set both for
# a new deployment unless compatibility with an older deployment requires it.
# META_EMBEDDED_SIGNUP_CONFIG_ID=

# ============================================================
# FLYER LADY — FACEBOOK / INSTAGRAM CONNECTION
# ============================================================
# Required for the current Flyer Lady social connection flow. This is separate
# from WhatsApp and Embedded Signup configuration.
META_FLYER_LADY_CONFIG_ID=

# Optional in code (the callback URL can be generated automatically), but
# strongly recommended to set explicitly in production and register in Meta.
META_SOCIAL_REDIRECT_URI=

# Optional override. Leave unset to use the application's built-in default
# scopes for the Flyer Lady social connection flow.
# META_SOCIAL_OAUTH_SCOPES=

# Instagram uses the connected client's stored social credentials/account IDs.
# Do NOT add global INSTAGRAM_ACCESS_TOKEN or INSTAGRAM_ACCOUNT_ID variables
# here unless the application architecture is intentionally changed.

# Public application URL used when generating Flyer Lady tracked links.
# Keep PHANTA_PUBLIC_BASE_URL and PUBLIC_BASE_URL aligned unless the deployment
# intentionally uses separate internal/public origins.
PHANTA_PUBLIC_BASE_URL=
PHANTA_BASE_URL=

# Local/server directory used for Flyer Lady prepared WhatsApp Status assets.
FLYER_LADY_UPLOAD_DIR=static/uploads/flyer_lady

# ============================================================
# PUBLIC URLS / BILLING / ATTRIBUTION
# ============================================================
PUBLIC_BASE_URL=
BILLING_EMAIL=
ADMIN_EMAIL=

# ============================================================
# PAYSTACK
# ============================================================
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ============================================================
# OPENAI / SERVICE ADVISOR
# ============================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# SCHEDULER / AUTOMATIONS
# ============================================================
PHANTA_READY_COLLECTION_NUDGE_HOURS=24

# ============================================================
# ALEMBIC / MIGRATIONS
# ============================================================
SKIP_ALEMBIC_MIGRATIONS=false
STRICT_ALEMBIC_MIGRATIONS=true

# ============================================================
# ACCESS CONTROL / SESSIONS
# ============================================================
# Self-service registration requires this code. If it is not set in a
# production deployment, registration is disabled entirely (fail closed).
REGISTRATION_INVITE_CODE=
# Sliding inactivity timeout for signed-in sessions.
SESSION_LIFETIME_HOURS=12
# Days that raw WhatsApp message text is retained before being cleared by
# the daily retention job. Changing this changes what PHANTA's privacy
# documentation states -- keep the two in agreement.
MESSAGE_BODY_RETENTION_DAYS=14
# Hosting provider's backup retention window. This is NOT a PHANTA setting --
# it must match what Railway/PostgreSQL actually retains. Used to tell an
# offboarded workshop when their data ages out of backups. VERIFY IT.
BACKUP_RETENTION_DAYS=30
# Leave unset in production. Only the automated test suite sets this to false.
RATELIMIT_ENABLED=true

# ============================================================
# OPTIONAL OBSERVABILITY
# ============================================================
SENTRY_DSN=
