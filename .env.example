# PHANTA production environment template. Never commit real secrets.
# Copy to .env locally and replace every REQUIRED value with a real secret/config value.
# Railway: add these as Railway Variables; do not upload a real .env file to Git.

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/phanta
# Railway PostgreSQL may also expose these values; PHANTA can construct DATABASE_URL from them:
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGCONNECT_TIMEOUT=5
PGPOOL_MINCONN=1
PGPOOL_MAXCONN=5
REQUIRE_DATABASE_URL=true
PHANTA_SQLITE_PATH=phanta.db
PHANTA_TEST_POSTGRES_URL=

# ============================================================
# APPLICATION / FLASK
# ============================================================
FLASK_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DEV_FLASK_SECRET_KEY=
FLASK_ENV=production
APP_ENV=production
ENVIRONMENT=production
PORT=8080
WEB_CONCURRENCY=2
LOG_LEVEL=INFO
DEFAULT_RATE_LIMIT=300 per hour
RATELIMIT_STORAGE_URI=memory://
RAILWAY_ENVIRONMENT=
RAILWAY_SERVICE_ID=

# ============================================================
# SUPER ADMIN BOOTSTRAP
# ============================================================
SUPERADMIN_USERNAME=admin@phanta.local
SUPERADMIN_PASSWORD=REPLACE_BEFORE_PRODUCTION_USE
SUPERADMIN_NAME=PHANTA Platform Super Admin
ALLOW_DEV_DEFAULT_CREDENTIALS=false
DEV_SUPERADMIN_PASSWORD=

# ============================================================
# META — SHARED WHATSAPP + SOCIAL APP CONFIGURATION
# ============================================================
# Same Meta App can be used for WhatsApp and Flyer Lady social publishing,
# provided the required products/permissions are configured and approved.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_APP_DOMAINS=
META_SYSTEM_USER_TOKEN=
META_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
META_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_A_RANDOM_WEBHOOK_VERIFY_TOKEN

# Existing WhatsApp Embedded Signup
META_WHATSAPP_CONFIG_ID=
# Backward-compatible alias used by the current WhatsApp integration. Keep both
# values identical until the WhatsApp config refactor is completed.
META_EMBEDDED_SIGNUP_CONFIG_ID=

# ============================================================
# META / FLYER LADY SOCIAL PUBLISHING
# ============================================================
# OAuth callback registered in the Meta Developer App.
META_FLYER_LADY_CONFIG_ID=
META_SOCIAL_REDIRECT_URI=

# Comma-separated scopes requested by the Flyer Lady social connection flow.
# Confirm exact scope names/availability in Meta App Dashboard before production.
META_SOCIAL_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_metadata,business_management,instagram_basic,instagram_content_publish

# Public application URL used when generating Flyer Lady tracked links.
# Keep PHANTA_PUBLIC_BASE_URL and PUBLIC_BASE_URL aligned unless the deployment
# intentionally uses separate internal/public origins.
PHANTA_PUBLIC_BASE_URL=
PHANTA_BASE_URL=

# Local/server directory used for Flyer Lady prepared WhatsApp Status assets.
FLYER_LADY_UPLOAD_DIR=static/uploads/flyer_lady

# ============================================================
# PUBLIC URLS / BILLING / ATTRIBUTION
# ============================================================
PUBLIC_BASE_URL=
BILLING_EMAIL=
ADMIN_EMAIL=

# ============================================================
# PAYSTACK
# ============================================================
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ============================================================
# OPENAI / SERVICE ADVISOR
# ============================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# SCHEDULER / AUTOMATIONS
# ============================================================
PHANTA_READY_COLLECTION_NUDGE_HOURS=24

# ============================================================
# ALEMBIC / MIGRATIONS
# ============================================================
SKIP_ALEMBIC_MIGRATIONS=false
STRICT_ALEMBIC_MIGRATIONS=true

# ============================================================
# OPTIONAL OBSERVABILITY
# ============================================================
SENTRY_DSN=
