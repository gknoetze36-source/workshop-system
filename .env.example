# ============================================================================
# Workshop SaaS Platform - Environment Configuration Template
# Copy this file to .env and fill in actual values for your environment
# ============================================================================

# DATABASE CONFIGURATION
# PostgreSQL connection string for production
DATABASE_URL=postgresql://user:password@localhost:5432/workshop_saas

# FLASK CONFIGURATION
# Secret key for session encryption (minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-very-secret-key-minimum-32-characters-required

# Environment: development, testing, or production
FLASK_ENV=production

# PAYSTACK PAYMENT INTEGRATION
# Get from: https://dashboard.paystack.com/settings/developer
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here

# META WHATSAPP INTEGRATION
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=EAAxx...your_access_token_here
META_VERIFY_TOKEN=any_random_verification_token_min_20_chars

# OPENAI INTEGRATION (for AI features)
OPENAI_API_KEY=sk-...your_openai_api_key_here

# SECURITY & ENCRYPTION
# Encryption key for messaging tokens (minimum 32 characters)
MESSAGING_TOKEN_ENCRYPTION_KEY=your-encryption-key-32-chars-minimum

# SERVER CONFIGURATION
PORT=8080
WEB_CONCURRENCY=4
DEFAULT_RATE_LIMIT=300 per hour
RATELIMIT_STORAGE_URI=memory://

# TEMPORARY PASSWORDS
TEMP_PASSWORD=

# LOGGING CONFIGURATION
LOG_LEVEL=INFO

# DEVELOPMENT ONLY
RUN_LEGACY_BOOTSTRAP=

# OPTIONAL: SENTRY ERROR TRACKING
SENTRY_DSN=

# OPTIONAL: ENVIRONMENT LABEL
ENVIRONMENT=production
