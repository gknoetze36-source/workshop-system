# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# Local databases
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal
*.sqlite3-journal

# Backups and exports
*.bak
*.backup
*.dump
*.sql
backups/
exports/

# Uploads and media generated at runtime
uploads/
media/
static/uploads/
static/media/
instance/

# Logs and temp files
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo

# Build artifacts
node_modules/
build/
dist/
*.egg-info/
.coverage
htmlcov/

# Versioned database schema artifacts
!database/schema/*.sql

# IDE and OS files
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
